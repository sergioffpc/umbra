#include "umbra/core/build_info.h"

namespace umbra::core {

BuildInfo GetBuildInfo() {
  return {
      .commit = "@UMBRA_COMMIT@",
      .build_type = "@UMBRA_BUILD_TYPE@",
      .arch = "@UMBRA_ARCH@",
      .compiler = "@UMBRA_COMPILER@",
  };
}

}  // namespace umbra::core
