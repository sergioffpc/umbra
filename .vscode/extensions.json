{
  // Extensions recommended for working on umbra. VS Code offers to install
  // them when the folder is opened; the dev container installs them itself.
  // Only the essentials: spelling, EditorConfig, shell scripts, workflows,
  // dependencies and commit messages are checked by .githooks/ instead.
  "recommendations": [
    // Rust language server: completion, diagnostics (clippy on save), tests.
    "rust-lang.rust-analyzer",
    // Native debugger for Rust (launch.json).
    "vadimcn.vscode-lldb",
    // TOML: Cargo.toml, rustfmt.toml, clippy.toml, deny.toml, ...
    "tamasfe.even-better-toml",
    // Claude Code; the dev container also installs the CLI.
    "anthropic.claude-code",
    // Reopens the folder in the dev container (.devcontainer/).
    "ms-vscode-remote.remote-containers"
  ],
  "unwantedRecommendations": [
    // Deprecated predecessors of rust-analyzer and of crate version hints.
    "rust-lang.rust",
    "serayuzgur.crates",
    // C/C++ tooling would compete with CodeLLDB and rust-analyzer.
    "ms-vscode.cpptools",
    "llvm-vs-code-extensions.vscode-clangd"
  ]
}
