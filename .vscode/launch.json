{
  // CodeLLDB (vadimcn.vscode-lldb) launch configurations. Each one builds the
  // binary first through cargo, so no preLaunchTask is needed. The run/debug
  // lenses that rust-analyzer shows above `main` and `#[test]` use CodeLLDB
  // too.
  "version": "0.2.0",
  "configurations": [
    {
      // Attaches to a running `umbra`, such as a Worker left running. The
      // process must come from a build with debug info (dev, profiling or
      // checked).
      "name": "umbra (attach)",
      "type": "lldb",
      "request": "attach",
      "pid": "${command:pickMyProcess}"
    },
    {
      "name": "umbra (bin tests)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["test", "--no-run", "--bin=umbra", "--package=umbra"],
        "filter": { "name": "umbra", "kind": "bin" }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "env": { "RUST_BACKTRACE": "1" }
    },
    {
      // Release speed with debug assertions and overflow checks on: for a
      // panic that only a long render reaches.
      "name": "umbra (checked)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "--bin=umbra", "--package=umbra", "--profile=checked"],
        "filter": { "name": "umbra", "kind": "bin" }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "env": { "RUST_BACKTRACE": "1" }
    },
    {
      "name": "umbra (dev)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "--bin=umbra", "--package=umbra"],
        "filter": { "name": "umbra", "kind": "bin" }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "env": { "RUST_BACKTRACE": "1" }
    },
    {
      // Unit tests of one library crate, chosen when the session starts. Put
      // a test name filter in "args" to run fewer of them.
      "name": "umbra (lib tests)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["test", "--no-run", "--lib", "--package=${input:crate}"],
        "filter": { "kind": "lib" }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "env": { "RUST_BACKTRACE": "1" }
    },
    {
      // Release speed with full debug info: for bugs that only show up in
      // long renders. Inlining makes stepping jumpier than in dev.
      "name": "umbra (profiling)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "--bin=umbra", "--package=umbra", "--profile=profiling"],
        "filter": { "name": "umbra", "kind": "bin" }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "env": { "RUST_BACKTRACE": "1" }
    },
    {
      // Coordinator with its local Worker, on a Scene File asked for at
      // launch. UMBRA_CLUSTER keeps debug sessions apart from the Workers of
      // the default Cluster on the LAN.
      "name": "umbra (render)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "--bin=umbra", "--package=umbra"],
        "filter": { "name": "umbra", "kind": "bin" }
      },
      "args": ["render", "${input:scene}"],
      "cwd": "${workspaceFolder}",
      "env": { "RUST_BACKTRACE": "1", "UMBRA_CLUSTER": "debug" }
    },
    {
      // A Worker of the `debug` Cluster: it waits for "umbra (render)",
      // started here or from another window.
      "name": "umbra (worker)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "--bin=umbra", "--package=umbra"],
        "filter": { "name": "umbra", "kind": "bin" }
      },
      "args": ["worker"],
      "cwd": "${workspaceFolder}",
      "env": { "RUST_BACKTRACE": "1", "UMBRA_CLUSTER": "debug" }
    }
  ],
  "compounds": [
    {
      // Both ends of the wire protocol in one debug session: the Worker
      // first, then the Coordinator that gives it work.
      "name": "umbra (cluster)",
      "configurations": ["umbra (worker)", "umbra (render)"],
      "stopAll": true
    }
  ],
  "inputs": [
    {
      "id": "crate",
      "type": "pickString",
      "description": "Library crate whose unit tests to debug",
      "options": [
        "umbra-camera",
        "umbra-cluster",
        "umbra-geometry",
        "umbra-integrators",
        "umbra-math",
        "umbra-parser",
        "umbra-render",
        "umbra-sampling",
        "umbra-scene",
        "umbra-shading",
        "umbra-spectrum"
      ]
    },
    {
      "id": "scene",
      "type": "promptString",
      "description": "Scene File to render (pbrt-v4)",
      "default": "scene.pbrt"
    }
  ]
}
