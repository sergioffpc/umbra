{
  // Cargo tasks. The "check:" tasks run scripts/check.sh, the checks CI runs;
  // "check: all" is "Before opening a pull request" in CONTRIBUTING.md.
  //
  // Ctrl/Cmd+Shift+B runs the default build task, and "Tasks: Run Test
  // Task" the default test task.
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "presentation": {
    "reveal": "always",
    "panel": "dedicated",
    "clear": true,
    "showReuseMessage": false
  },
  "tasks": [
    // ------------------------------------------------------------- Build
    {
      "label": "build: dev",
      "detail": "cargo build (opt-level 1, full debug info, all checks)",
      "type": "process",
      "command": "cargo",
      "args": ["build", "--all-targets", "--all-features"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "build: release",
      "detail": "cargo build --release (fat LTO, panic = abort)",
      "type": "process",
      "command": "cargo",
      "args": ["build", "--release", "--all-features"],
      "group": "build",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "build: profiling",
      "detail": "cargo build --profile profiling (release speed, full debug info)",
      "type": "process",
      "command": "cargo",
      "args": ["build", "--profile", "profiling", "--all-features"],
      "group": "build",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "build: checked",
      "detail": "cargo build --profile checked (release speed, debug assertions)",
      "type": "process",
      "command": "cargo",
      "args": ["build", "--profile", "checked", "--all-features"],
      "group": "build",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "run: release",
      "detail": "cargo run --release",
      "type": "process",
      "command": "cargo",
      "args": ["run", "--release"],
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "clean",
      "detail": "cargo clean",
      "type": "process",
      "command": "cargo",
      "args": ["clean"],
      "problemMatcher": []
    },

    // ------------------------------------------------------------- Test
    {
      "label": "test",
      "detail": "cargo nextest run",
      "type": "process",
      "command": "cargo",
      "args": ["nextest", "run", "--all-features", "--locked"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$rustc", "$rust-panic"]
    },
    {
      "label": "coverage: html report",
      "detail": "cargo cov --open (HTML report in the browser)",
      "type": "process",
      "command": "cargo",
      "args": ["cov", "--open"],
      "group": "test",
      "problemMatcher": ["$rustc", "$rust-panic"]
    },

    // ------------------------------------------------------------- Format
    {
      "label": "fmt",
      "detail": "cargo fmt --all",
      "type": "process",
      "command": "cargo",
      "args": ["fmt", "--all"],
      "problemMatcher": []
    },
    {
      "label": "fmt: json, yaml, markdown, toml",
      "detail": "prettier --write and taplo fmt on every tracked file",
      "type": "shell",
      "command": "git ls-files -z '*.json' '*.yml' '*.yaml' '*.md' | xargs -0 prettier --write --log-level warn && git ls-files -z '*.toml' | xargs -0 taplo fmt",
      "problemMatcher": []
    },

    // ------------------------------------------------------------- Checks
    {
      "label": "check: rust",
      "detail": "scripts/check.sh rust: fmt, clippy, doc, nextest, doctests",
      "type": "process",
      "command": "scripts/check.sh",
      "args": ["rust"],
      "problemMatcher": ["$rustc", "$rust-panic"]
    },
    {
      "label": "check: lint",
      "detail": "scripts/check.sh lint: typos, unused dependencies and the linters, on every tracked file",
      "type": "process",
      "command": "scripts/check.sh",
      "args": ["lint"],
      "problemMatcher": []
    },
    {
      "label": "check: deny",
      "detail": "scripts/check.sh deny: advisories, bans, licenses and sources",
      "type": "process",
      "command": "scripts/check.sh",
      "args": ["deny"],
      "problemMatcher": []
    },
    {
      "label": "check: miri",
      "detail": "scripts/check.sh miri: umbra-math's tests under Miri, glibc's libm called natively (slow)",
      "type": "process",
      "command": "scripts/check.sh",
      "args": ["miri"],
      "problemMatcher": ["$rustc", "$rust-panic"]
    },
    {
      "label": "check: asan",
      "detail": "scripts/check.sh asan: umbra-math's tests under AddressSanitizer",
      "type": "process",
      "command": "scripts/check.sh",
      "args": ["asan"],
      "problemMatcher": ["$rustc", "$rust-panic"]
    },
    {
      "label": "check: all",
      "detail": "scripts/check.sh: everything CI runs but Miri and AddressSanitizer (stops at the first failure)",
      "type": "process",
      "command": "scripts/check.sh",
      "problemMatcher": ["$rustc", "$rust-panic"]
    },

    // ------------------------------------------------------------- Docs
    {
      "label": "doc: open",
      "detail": "cargo doc --open",
      "type": "process",
      "command": "cargo",
      "args": ["doc", "--no-deps", "--document-private-items", "--all-features", "--open"],
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "changelog: preview",
      "detail": "git cliff --unreleased",
      "type": "process",
      "command": "git",
      "args": ["cliff", "--unreleased"],
      "problemMatcher": []
    }
  ]
}
