#
# Writes a C++ source that embeds a binary file (script mode, run by
# umbra_add_optix_ir in UmbraCuda.cmake):
#
#   cmake -DINPUT=<file>[;<file>...] -DOUTPUT=<file.cc> -DFUNCTION=<name>
#         -DNAMESPACE=<namespace> -P GenerateEmbeddedData.cmake
#
# The source defines `std::span<const char> <NAMESPACE>::<FUNCTION>()`,
# returning the bytes of the first INPUT file as char, the type the APIs that
# take such blobs (OptiX) use. OUTPUT is rewritten only when its contents
# change.

foreach(variable IN ITEMS INPUT OUTPUT FUNCTION NAMESPACE)
  if(NOT DEFINED ${variable})
    message(FATAL_ERROR "GenerateEmbeddedData.cmake needs -D${variable}=...")
  endif()
endforeach()

list(GET INPUT 0 input)
file(READ "${input}" hex HEX)
string(LENGTH "${hex}" hex_length)
math(EXPR size "${hex_length} / 2")
if(size EQUAL 0)
  message(FATAL_ERROR "${input} is empty")
endif()
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "'\\\\x\\1'," bytes "${hex}")
# Twelve bytes per line (CMake regexes have no {n}).
string(REPEAT "'\\\\x[0-9a-f][0-9a-f]'," 12 line)
string(REGEX REPLACE "(${line})" "\\1\n    " bytes "${bytes}")
cmake_path(GET input FILENAME input_name)

file(CONFIGURE OUTPUT "${OUTPUT}" @ONLY CONTENT [[
// Generated by cmake/GenerateEmbeddedData.cmake from @input_name@. Do not
// edit.

#include <array>
#include <span>

namespace @NAMESPACE@ {
namespace {

constexpr std::array<char, @size@> kData{
    @bytes@};

}  // namespace

std::span<const char> @FUNCTION@() { return kData; }

}  // namespace @NAMESPACE@
]])
