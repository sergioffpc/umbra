# Normalise text to LF in the repository and the working tree.
* text=auto eol=lf

# Language-aware hunk headers in diffs.
*.rs diff=rust
*.md diff=markdown

# Collapse the lockfile in GitHub PR diffs and keep it out of language stats.
Cargo.lock linguist-generated=true

# Scene description and material formats stay as plain text.
*.pbrt text
*.mtl text
*.spd text

# Images and meshes go to Git LFS: the repository stores small pointers and
# the content is fetched on checkout. Run scripts/setup-git.sh first.
*.exr filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
*.pfm filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.ply filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
