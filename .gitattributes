# Normalize all text files to LF in the repository and the working tree.
* text=auto eol=lf

# Source and configuration
*.c       text diff=cpp
*.cc      text diff=cpp
*.cpp     text diff=cpp
*.h       text diff=cpp
*.hpp     text diff=cpp
*.inc     text diff=cpp
*.py      text diff=python
*.cmake   text
*.md      text diff=markdown
*.json    text
*.yml     text
*.yaml    text
*.toml    text
*.sh      text eol=lf
*.patch   text -whitespace
Dockerfile text

# Binary files
*.png  binary
*.jpg  binary
*.exr  binary
*.hdr  binary
*.usd  binary
*.usdc binary
