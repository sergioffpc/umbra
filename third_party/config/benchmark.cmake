# Initial cache for Google Benchmark (cmake -C): the library only, without
# exceptions, tests, tools, documentation or LTO. The common settings of the
# layer come from layers/deps.cmake.

set(BENCHMARK_ENABLE_EXCEPTIONS OFF CACHE BOOL "")
set(BENCHMARK_USE_LIBCXX ON CACHE BOOL "")
set(BENCHMARK_ENABLE_LTO OFF CACHE BOOL "")
set(BENCHMARK_ENABLE_WERROR OFF CACHE BOOL "")
set(BENCHMARK_ENABLE_TESTING OFF CACHE BOOL "")
set(BENCHMARK_ENABLE_GTEST_TESTS OFF CACHE BOOL "")
set(BENCHMARK_ENABLE_ASSEMBLY_TESTS OFF CACHE BOOL "")
set(BENCHMARK_ENABLE_LIBPFM OFF CACHE BOOL "")
set(BENCHMARK_ENABLE_DOXYGEN OFF CACHE BOOL "")
set(BENCHMARK_DOWNLOAD_DEPENDENCIES OFF CACHE BOOL "")
set(BENCHMARK_INSTALL_DOCS OFF CACHE BOOL "")
set(BENCHMARK_INSTALL_TOOLS OFF CACHE BOOL "")
set(BENCHMARK_ENABLE_INSTALL ON CACHE BOOL "")
