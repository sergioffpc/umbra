Keep the install RPATHs relative.

OSL adds to the install RPATH every directory outside the build tree that
it links from. The deps layer installs relocatable libraries, which find
each other through $ORIGIN; the tools in bin/ find them through
$ORIGIN/../lib, and LLVM and the Ubuntu libraries through the loader's
default paths.

diff --git a/src/cmake/compiler.cmake b/src/cmake/compiler.cmake
index 0c8bc464..ccd16405 100644
--- a/src/cmake/compiler.cmake
+++ b/src/cmake/compiler.cmake
@@ -641,9 +641,9 @@ else ()
     if (NOT CMAKE_INSTALL_RPATH)
         set (CMAKE_INSTALL_RPATH "${CMAKE_INSTALL_FULL_LIBDIR}")
     endif ()
-    # add the automatically determined parts of the RPATH that
-    # point to directories outside the build tree to the install RPATH
-    set (CMAKE_INSTALL_RPATH_USE_LINK_PATH TRUE)
+    # oslc and oslinfo, in bin/, find the libraries in lib/.
+    list (APPEND CMAKE_INSTALL_RPATH "$ORIGIN/../${CMAKE_INSTALL_LIBDIR}")
+    set (CMAKE_INSTALL_RPATH_USE_LINK_PATH FALSE)
     message (VERBOSE "CMAKE_INSTALL_RPATH = ${CMAKE_INSTALL_RPATH}")
 endif ()
 # OSL considerations because we run oslc in the course of building:
