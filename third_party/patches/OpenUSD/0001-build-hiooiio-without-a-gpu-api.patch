Build hioOiio without a GPU API.

hioOiio reads images for Hio through OpenImageIO and uses no graphics
API, but was skipped whenever GL, Metal and Vulkan were all off.

diff --git a/pxr/imaging/plugin/hioOiio/CMakeLists.txt b/pxr/imaging/plugin/hioOiio/CMakeLists.txt
index 637420062..68a128e9f 100644
--- a/pxr/imaging/plugin/hioOiio/CMakeLists.txt
+++ b/pxr/imaging/plugin/hioOiio/CMakeLists.txt
@@ -1,12 +1,6 @@
 set(PXR_PREFIX pxr/imaging)
 set(PXR_PACKAGE hioOiio)
 
-if (NOT ${PXR_BUILD_GPU_SUPPORT})
-    message(STATUS
-            "Skipping ${PXR_PACKAGE} because PXR_BUILD_GPU_SUPPORT is OFF")
-    return()
-endif()
-
 pxr_plugin(hioOiio
     LIBRARIES
         ar
