Include <type_traits> for std::aligned_storage.

trace/event.h uses std::aligned_storage and relies on another header to
bring in <type_traits>, which libstdc++ does and libc++ does not.

diff --git a/pxr/base/trace/event.h b/pxr/base/trace/event.h
index 969536349..d7842d732 100644
--- a/pxr/base/trace/event.h
+++ b/pxr/base/trace/event.h
@@ -16,6 +16,7 @@
 
 #include "pxr/base/arch/timing.h"
 
+#include <type_traits>
 #include <utility>
 
 PXR_NAMESPACE_OPEN_SCOPE
