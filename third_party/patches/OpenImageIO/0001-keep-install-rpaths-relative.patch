Keep the install RPATHs relative.

OpenImageIO adds to the install RPATH every directory outside the build
tree that it links from. The deps layer installs relocatable libraries,
which find each other through $ORIGIN, and the Ubuntu ones through the
loader's default paths.

diff --git a/src/cmake/compiler.cmake b/src/cmake/compiler.cmake
index 6cf2af00e..1fa6ed847 100644
--- a/src/cmake/compiler.cmake
+++ b/src/cmake/compiler.cmake
@@ -870,7 +870,7 @@ else ()
     endif ()
     # add the automatically determined parts of the RPATH that
     # point to directories outside the build tree to the install RPATH
-    set (CMAKE_INSTALL_RPATH_USE_LINK_PATH TRUE)
+    set (CMAKE_INSTALL_RPATH_USE_LINK_PATH FALSE)
     message (VERBOSE "CMAKE_INSTALL_RPATH = ${CMAKE_INSTALL_RPATH}")
 endif ()
 
