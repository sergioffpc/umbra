#!/usr/bin/env sh
# Rejects pushes of branches and tags that do not follow the git flow names
# in CONTRIBUTING.md:
#   main, develop, feature/<name>, release/X.Y.Z, hotfix/X.Y.Z, tags vX.Y.Z
# <name> is lowercase letters, digits, '.', '_' and '-'.
# Then hands the push to Git LFS so LFS objects are uploaded.
set -eu

command -v git-lfs >/dev/null 2>&1 || {
    echo "pre-push: git-lfs is not installed; see CONTRIBUTING.md" >&2
    exit 2
}

# stdin is read twice (here and by git lfs), so keep a copy.
refs=$(cat)

status=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
    case "$remote_ref" in
        refs/heads/*)
            branch=${remote_ref#refs/heads/}
            if ! printf '%s\n' "$branch" | grep -Eq \
                '^(main|develop|feature/[a-z0-9][a-z0-9._-]*|(release|hotfix)/[0-9]+\.[0-9]+\.[0-9]+)$'; then
                echo "pre-push: branch '$branch' does not follow git flow naming" >&2
                status=1
            fi
            ;;
        refs/tags/*)
            tag=${remote_ref#refs/tags/}
            if ! printf '%s\n' "$tag" | grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+$'; then
                echo "pre-push: tag '$tag' must look like vX.Y.Z" >&2
                status=1
            fi
            ;;
    esac
done <<REFS
$refs
REFS

if [ "$status" -ne 0 ]; then
    echo "pre-push: allowed: main, develop, feature/<name>, release/X.Y.Z, hotfix/X.Y.Z, tags vX.Y.Z" >&2
    exit "$status"
fi

printf '%s\n' "$refs" | git lfs pre-push "$@"
