#!/usr/bin/env sh
# Rejects commit messages that are not Conventional Commits 1.0.0:
#   <type>(<scope>)?!?: <description>
# Rules (see CONTRIBUTING.md):
#   - type is one of the allowed types below
#   - scope, if present, is lowercase: letters, digits, '.', '_', '/', '-'
#   - description starts lowercase, does not end with '.', header <= 72 chars
#   - a blank line separates the header from the body
#   - '!' requires a 'BREAKING CHANGE:' (or 'BREAKING-CHANGE:') footer
# Merge, revert, fixup! and squash! messages generated by git are allowed.
set -eu

msg_file="$1"
types="feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert"

# Drop comment lines and everything below the scissors line, as git does.
msg=$(sed -e '/^# ------------------------ >8 ------------------------$/,$d' -e '/^#/d' "$msg_file")
header=$(printf '%s\n' "$msg" | sed -n '1p')

fail() {
    {
        echo "commit-msg: $1"
        echo "  header: $header"
        echo "  expected: <type>(<scope>)?!?: <description>"
        echo "  types: $(echo "$types" | tr '|' ' ')"
        echo "  example: feat(bvh): add SAH split"
    } >&2
    exit 1
}

case "$header" in
    "Merge "* | "Revert \""* | "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
    "") fail "empty commit message" ;;
esac

printf '%s\n' "$header" | grep -Eq "^($types)(\([a-z0-9._/-]+\))?!?: " ||
    fail "header does not start with a valid type"

description=${header#*: }
printf '%s\n' "$description" | grep -Eq '^[^A-Z[:space:]]' ||
    fail "description must start with a lowercase, non-blank character"
case "$description" in
    *.) fail "description must not end with a period" ;;
esac

[ "${#header}" -le 72 ] || fail "header is ${#header} chars; the limit is 72"

second=$(printf '%s\n' "$msg" | sed -n '2p')
[ -z "$second" ] || fail "leave a blank line between the header and the body"

if printf '%s\n' "$header" | grep -Eq "^($types)(\([a-z0-9._/-]+\))?!: "; then
    printf '%s\n' "$msg" | grep -Eq '^BREAKING[ -]CHANGE: .+' ||
        fail "'!' marks a breaking change; add a 'BREAKING CHANGE: <details>' footer"
fi
