"""Validate the commit message against Conventional Commits and project rules.

The message must carry the author's Developer Certificate of Origin sign-off
(``git commit -s``).

fixup!, squash! and amend! commits are accepted here so that
``git commit --fixup`` keeps working locally; CI rejects them.

Merge commits on a release or hotfix branch (release/X.Y.Z, hotfix/X.Y.Z),
the git flow back-merges, are not checked, as in CI.

Usage (run by git): .githooks/commit-msg MESSAGE_FILE
"""

# git fixes the hook file name, which is not a valid module name.
# pylint: disable=invalid-name

from collections.abc import Sequence
import pathlib
import re
import subprocess
import sys

# The checks package lives at the repository root, which is not on the import
# path of a hook; it is added before importing it.
sys.dont_write_bytecode = True
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent))

# pylint: disable=wrong-import-position
from checks import branch_name
from checks import commit_message
from checks import git
from checks import report

# pylint: enable=wrong-import-position

MERGE_BRANCH = re.compile(rf"^(?:release|hotfix)/{branch_name.VERSION}$")


def comment_char() -> str:
    """Returns the comment prefix git uses in message files."""
    value = git.config(
        "core.commentString", git.config("core.commentChar", "#")
    )
    return "#" if value == "auto" else value


def is_release_merge() -> bool:
    """Returns whether the commit is a merge on a release or hotfix branch."""
    try:
        git.run("rev-parse", "--quiet", "--verify", "MERGE_HEAD")
        branch = git.run("symbolic-ref", "--quiet", "--short", "HEAD")
    except subprocess.CalledProcessError:
        return False
    return bool(MERGE_BRANCH.match(branch.strip()))


def main(argv: Sequence[str]) -> int:
    """Validates the commit message file that git passes to the hook.

    Args:
        argv: The hook arguments: the path of the message file.

    Returns:
        The process exit status: 0 when the message is valid, 1 otherwise.
    """
    if is_release_merge():
        return 0
    raw = pathlib.Path(argv[0]).read_text(encoding="utf-8")
    message = commit_message.clean(raw, comment_char())
    errors = commit_message.validate(
        message,
        commit_message.allowed_scopes(),
        allow_autosquash=True,
        author=commit_message.author_email(),
    )
    return report.fail("invalid commit message", errors)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
