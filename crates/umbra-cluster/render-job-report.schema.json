{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RenderJobReport",
  "description": "What a Render Job leaves behind besides its image, written next to it\nas `<image>.report.json`, finished or cancelled.",
  "type": "object",
  "properties": {
    "film_hash": {
      "description": "The Film hash, when it finished.",
      "type": [
        "string",
        "null"
      ]
    },
    "local_worker": {
      "description": "What the Local Worker did.",
      "$ref": "#/$defs/WorkerFigures"
    },
    "options": {
      "description": "The options it ran with.",
      "$ref": "#/$defs/ReportOptions"
    },
    "outcome": {
      "description": "How the Render Job ended.",
      "$ref": "#/$defs/Outcome"
    },
    "phase_times": {
      "description": "How long each phase took.",
      "$ref": "#/$defs/PhaseTimes"
    },
    "pixel_samples": {
      "description": "The Pixel Samples merged into the Film.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "pixel_samples_per_second": {
      "description": "The Pixel Samples merged per second of the render phase: comparable.",
      "type": "number",
      "format": "double"
    },
    "reproduction_record": {
      "description": "How to compute any of its Pixel Samples again (arc42 §8.9).",
      "$ref": "#/$defs/ReproductionRecord"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "tile_costs": {
      "description": "Each Tile's render time over the Worker's mean time per Pixel\nSample, summed over its Passes, in raster order: its cost in Pixel\nSamples at the Worker's mean speed.",
      "type": "array",
      "items": {
        "type": "number",
        "format": "double"
      }
    }
  },
  "required": [
    "schema_version",
    "outcome",
    "options",
    "phase_times",
    "pixel_samples",
    "pixel_samples_per_second",
    "local_worker",
    "tile_costs",
    "reproduction_record"
  ],
  "$defs": {
    "BuildIdentity": {
      "description": "What a binary was built from (arc42 §7.2, ADR 0012): its commit, and\nwhether the tree was dirty.",
      "type": "object",
      "properties": {
        "commit": {
          "description": "The git commit, in full.",
          "type": "string"
        },
        "tree": {
          "description": "Whether the tree had uncommitted changes.",
          "$ref": "#/$defs/Tree"
        }
      },
      "required": [
        "commit",
        "tree"
      ]
    },
    "Outcome": {
      "description": "How a Render Job ended.",
      "oneOf": [
        {
          "description": "Every Pass was rendered and merged; the image exists.",
          "type": "string",
          "const": "finished"
        },
        {
          "description": "It was cancelled before the end; there is no image (ADR 0004).",
          "type": "string",
          "const": "cancelled"
        }
      ]
    },
    "PhaseTimes": {
      "description": "How long each phase took, in seconds; `null` for a phase that did not\nrun: one after a cancellation, or the BVH build of a Scene without one.",
      "type": "object",
      "properties": {
        "bvh_build": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "image_write": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "merge": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "parse": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "render": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "scene_build": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      }
    },
    "ReportOptions": {
      "description": "The Render Job Options and the Coordinator options it ran with.",
      "type": "object",
      "properties": {
        "seed": {
          "type": "integer",
          "format": "int32"
        },
        "spp": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "spp_per_pass": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "threads": {
          "description": "The Local Worker's threads.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "tile_size": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "seed",
        "spp",
        "spp_per_pass",
        "tile_size",
        "threads"
      ]
    },
    "ReproductionRecord": {
      "description": "The Reproduction Record of a Render Job: the Scene File and the content\nhash of everything it read, the seed, every Render Job Option but the\noutput path, and the Build Identity. Its JSON is versioned, and the\nRender Job Report carries it as `reproduction_record`.",
      "type": "object",
      "properties": {
        "build_identity": {
          "$ref": "#/$defs/BuildIdentity"
        },
        "content_hash": {
          "type": "string"
        },
        "scene_file": {
          "type": "string"
        },
        "seed": {
          "type": "integer",
          "format": "int32"
        },
        "spp": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "spp_per_pass": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "tile_size": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "version",
        "scene_file",
        "content_hash",
        "seed",
        "tile_size",
        "spp_per_pass",
        "spp",
        "build_identity"
      ]
    },
    "SchemaVersion": {
      "description": "The version of the Render Job Report's schema, written as\n`{\"major\": 0, \"minor\": 2}`. Reports of one major version can be\ncompared; see [`RenderJobReport::SCHEMA_VERSION`].",
      "type": "object",
      "properties": {
        "major": {
          "description": "Changes with the meaning of a comparable field.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "minor": {
          "description": "Changes with any other field.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "major",
        "minor"
      ]
    },
    "Tree": {
      "description": "Whether a binary was built from a tree with uncommitted changes.",
      "oneOf": [
        {
          "description": "Built from the commit, unchanged.",
          "type": "string",
          "const": "clean"
        },
        {
          "description": "Built with uncommitted changes on top of the commit.",
          "type": "string",
          "const": "dirty"
        }
      ]
    },
    "WorkerFigures": {
      "description": "What the Local Worker did.",
      "type": "object",
      "properties": {
        "busy_time": {
          "description": "The time it had a Work Unit in flight, in seconds.",
          "type": "number",
          "format": "double"
        },
        "idle_time": {
          "description": "The rest of the render phase, in seconds.",
          "type": "number",
          "format": "double"
        },
        "pixel_samples": {
          "description": "The Pixel Samples of those.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "threads": {
          "description": "Its threads.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "work_units": {
          "description": "The Work Units whose Work Results were merged.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "threads",
        "work_units",
        "pixel_samples",
        "busy_time",
        "idle_time"
      ]
    }
  }
}
