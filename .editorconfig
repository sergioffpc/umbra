# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 80

[{*.py,.githooks/*}]
indent_size = 4
max_line_length = 80

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[{Makefile,*.mk}]
indent_style = tab
indent_size = 8

[LICENSE]
max_line_length = off

[*.patch]
trim_trailing_whitespace = false
max_line_length = off
