#
# ThreadSanitizer suppressions, read by every executable of the tsan preset
# (see sanitizers/default_options.cc).
#
# ThreadSanitizer targets umbra's own code. The dependencies are not
# instrumented, so a race inside one of them is not umbra's to chase: when a
# library is proven to report false positives (typically through
# synchronization TSan cannot see), suppress the reports
# that originate in it with a called_from_lib entry, never with a pattern
# matching umbra's code.
#
# Keep this file minimal. Every entry is preceded by a comment that names the
# library, the report it causes and why that report is not a bug in umbra:
#
#   # <library>: <report and why it is a false positive>.
#   called_from_lib:<library file name>
#
# oneTBB is the exception: its synchronization is in libtbb while the code
# that relies on it is inlined into umbra, so the tsan preset links a libtbb
# instrumented with ThreadSanitizer (see cmake/UmbraSanitizers.cmake) instead
# of suppressing anything.

# compute-sanitizer: `make tsan LABEL=<regex>` runs the tests under NVIDIA's
# compute-sanitizer, which injects this library into every process. Its own
# threads synchronize in code TSan does not instrument, so TSan reports races
# inside it that do not involve umbra's memory.
called_from_lib:libsanitizer-collection.so
