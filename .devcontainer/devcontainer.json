//
// The only supported environment, for VS Code Dev Containers on rootless
// podman (user setting "dev.containers.dockerPath": "podman").
//
// The image is a private package (it carries the non-redistributable CUDA
// and OptiX build tools): log in first with `podman login ghcr.io
// --compat-auth-file ~/.docker/config.json`, the only login file the Dev
// Containers extension reads. The GPU is optional: on rootless podman it
// comes from the host's own CDI configuration (see "GPU hosts" in
// CONTRIBUTING.md), never from runArgs, so the same configuration starts
// unchanged on a host without a GPU.
{
  "name": "umbra",
  // Pinned by content hash: the deps workflow rewrites this line, and CI
  // fails when it differs from the hash of the current deps inputs.
  "image": "ghcr.io/sergioffpc/umbra-deps:6ca7e995c6734f92",

  // No "hostRequirements.gpu": its probe runs `podman info -f
  // {{.Runtimes.nvidia}}`, a Docker-only field, and podman fails the start.

  // The host user becomes the image's dev user (uid/gid 1000), so files in
  // the workspace keep the host user's ownership. lldb and the sanitizers
  // need ptrace and an unconfined seccomp profile.
  "runArgs": [
    "--userns=keep-id:uid=1000,gid=1000",
    "--cap-add=SYS_PTRACE",
    "--security-opt=seccomp=unconfined"
  ],
  "containerUser": "dev",
  "remoteUser": "dev",
  // keep-id already maps the host user onto dev.
  "updateRemoteUserUID": false,
  "containerEnv": {
    "HOME": "/home/dev",
    // OptiX ships with the driver as a graphics library, which the NVIDIA
    // runtime hook mounts only with the graphics capability.
    "NVIDIA_DRIVER_CAPABILITIES": "compute,utility,graphics",
    // Keeps .claude.json (account, trust) inside the persisted volume.
    "CLAUDE_CONFIG_DIR": "/home/dev/.claude"
  },
  "remoteEnv": {
    // Claude Code's native installer puts its launcher here.
    "PATH": "/home/dev/.local/bin:${containerEnv:PATH}"
  },
  // Claude Code and gh logins survive a rebuild. The image creates both
  // directories owned by dev, so new volumes are owned by dev too.
  //
  // The host's ~/.ssh is mounted read-only, so ssh in the container uses the
  // host's configuration, known hosts and keys as they are. The private keys
  // are therefore readable inside the container. New known hosts cannot be
  // recorded from here: connect from the host first. A bind mount of a
  // missing directory stops the container from starting, so
  // initializeCommand, which runs on the host, creates it when there is none.
  "initializeCommand": "mkdir -p -m 700 \"$HOME/.ssh\"",
  "mounts": [
    "source=umbra-claude,target=/home/dev/.claude,type=volume",
    "source=umbra-gh,target=/home/dev/.config/gh,type=volume",
    "source=${localEnv:HOME}/.ssh,target=/home/dev/.ssh,type=bind,readonly"
  ],

  // Developer-only tools are installed when the container is created, never
  // baked into the CI images.
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "2.103.3"
    }
  },
  "postCreateCommand": "python3 .devcontainer/post_create.py",

  // The settings live in .vscode/settings.json; the extensions are installed
  // here, when the container is created. The host's user settings restrict
  // installs to this set through "extensions.allowed".
  "customizations": {
    "vscode": {
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd",
        "llvm-vs-code-extensions.lldb-dap",
        "ms-vscode.cmake-tools",
        // Python: the checks, git hooks and devcontainer scripts. The
        // formatter and linters run the toolchain's own binaries.
        "ms-python.python",
        "ms-python.black-formatter",
        "ms-python.isort",
        "ms-python.pylint",
        "editorconfig.editorconfig",
        // Unwanted: clangd provides the C++ language features.
        "-ms-vscode.cpptools"
      ]
    }
  }
}
