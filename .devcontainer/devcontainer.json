// Dev container for umbra: VS Code "Dev Containers: Reopen in Container".
// https://containers.dev/implementors/json_reference/
{
  "name": "umbra",
  "build": {
    "dockerfile": "Dockerfile",
    // Repository root, so the Dockerfile can copy rust-toolchain.toml.
    "context": ".."
  },

  "features": {
    // gh: the issue tracker and pull requests are managed with the gh CLI.
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // Node.js and npm for the Claude Code feature, which needs npm and on
    // Ubuntu would otherwise apt-install nodejs without it.
    "ghcr.io/devcontainers/features/node:2": {},
    // Claude Code CLI; the Matt Pocock skills plugin is installed by
    // post-create.sh.
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },

  "remoteUser": "vscode",

  // The build output and the cargo download cache live in named volumes,
  // which survive container rebuilds.
  "mounts": [
    {
      "type": "volume",
      "source": "umbra-target-${devcontainerId}",
      "target": "${containerWorkspaceFolder}/target"
    },
    {
      "type": "volume",
      "source": "umbra-cargo-registry",
      "target": "/usr/local/cargo/registry"
    },
    {
      "type": "volume",
      "source": "umbra-cargo-git",
      "target": "/usr/local/cargo/git"
    }
  ],

  // LLDB needs ptrace to attach to the debuggee.
  "capAdd": ["SYS_PTRACE"],
  "securityOpt": ["seccomp=unconfined"],

  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    // The host's NVIDIA GPUs, where Docker has the NVIDIA Container Toolkit;
    // elsewhere the container starts without one. Podman hosts
    // fail the GPU detection, which queries Docker-only `info` fields: set
    // the VS Code user setting "dev.containers.gpuAvailability" to "all",
    // which Podman maps to the NVIDIA CDI spec (`nvidia-ctk cdi generate`).
    // On Podman hosts without an NVIDIA GPU, such as macOS, set it to "none"
    // instead.
    "gpu": "optional"
  },

  // What the NVIDIA Container Toolkit mounts from the host driver: `compute`
  // for libcuda, `graphics` for OptiX's libnvoptix and libnvidia-rtcore,
  // `utility` for nvidia-smi (arc42 §7). Ignored without a GPU.
  "containerEnv": {
    "NVIDIA_VISIBLE_DEVICES": "all",
    "NVIDIA_DRIVER_CAPABILITIES": "compute,graphics,utility"
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      // Keep in sync with .vscode/extensions.json (minus Dev Containers).
      "extensions": [
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb",
        "tamasfe.even-better-toml",
        "anthropic.claude-code"
      ],
      // Workspace settings come from .vscode/settings.json; only
      // container-specific ones go here.
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
